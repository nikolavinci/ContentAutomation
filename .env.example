# WordPress Content Automation - Environment Variables
# Copy this to .env and fill in your actual keys
# NEVER commit .env to git!

# Anthropic API Key - get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# (Optional) Copyscape API Key for plagiarism detection
# Get from https://www.copyscape.com/apiconfigure.php
COPYSCAPE_API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# (Optional) Email alerts for failures
ALERT_EMAIL=your-email@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=

# (Optional) Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# (Optional) Google Analytics API for traffic monitoring
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_API_KEY=
